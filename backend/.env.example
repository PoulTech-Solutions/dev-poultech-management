# Copy to `.env` and fill secrets. Every runtime knob below maps to Settings in
# `app/core/config.py` (env names are UPPER_SNAKE of the field name).
# Compose reads this file for ${VAR} substitution AND as env_file for api/worker.
# After editing this file: docker compose --profile app up -d --force-recreate (no --build).

APP_ENV=dev
LOG_LEVEL=DEBUG

# --- Postgres container (docker compose) ---
POSTGRES_USER=poultech
POSTGRES_PASSWORD=poultech
POSTGRES_DB=poultech_dev
POSTGRES_HOST_PORT=5433

# --- Host process (uvicorn / alembic on your machine) ---
DATABASE_URL=postgresql+asyncpg://poultech:poultech@localhost:5433/poultech_dev
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
REDIS_HOST_PORT=6379

# --- Inside Compose network (api / worker / migrate only) ---
DATABASE_URL_DOCKER=postgresql+asyncpg://poultech:poultech@postgres:5432/poultech_dev
REDIS_URL_DOCKER=redis://redis:6379/0
CELERY_BROKER_URL_DOCKER=redis://redis:6379/1
CELERY_RESULT_BACKEND_DOCKER=redis://redis:6379/2

# --- JWT (host paths relative to backend/) ---
JWT_PRIVATE_KEY_PATH=keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt_public.pem
JWT_PRIVATE_KEY_PATH_DOCKER=/srv/poultech/keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH_DOCKER=/srv/poultech/keys/jwt_public.pem
JWT_KEY_ID=key-2026-11
JWT_ISSUER=poultech-auth
JWT_AUDIENCE=poultech-api
ACCESS_TOKEN_MINUTES=10
REFRESH_TOKEN_DAYS=7
REFRESH_COOKIE_NAME=poultech_refresh
REFRESH_COOKIE_SAMESITE=lax
REMEMBER_ME_EXTRA_DAYS=23
REFRESH_GRACE_SECONDS=0
DEFAULT_ROLE_NAME=user

# --- OTP / login hardening ---
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5
OTP_HMAC_SECRET=change_me_run_gen_keys_script
# Optional; defaults to OTP_HMAC_SECRET when empty
OTP_TRANSPORT_KEY=
# Auth identity + /me profile Redis TTL (sess:{sid}, sess:{sid}:p). Keep short.
SESSION_CACHE_SECONDS=30
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
LOGIN_OTP_EXPIRY_NOTICE=5
MIN_PASSWORD_LENGTH=8
MAX_PASSWORD_LENGTH=128

# --- Email (same keys for host uvicorn and Docker api/worker — Compose does NOT remap SMTP) ---
# Brevo / SES / Gmail: set host/port/tls + SMTP_USER / SMTP_PASSWORD + verified SMTP_FROM
# Optional Mailpit only: docker compose --profile mailpit up -d mailpit, then SMTP_HOST=mailpit (worker) or localhost (host), port 1025, no TLS/user/pass; UI http://localhost:8025
# Brevo tip: if login fails with "525 Unauthorized IP address", open Brevo →
# SMTP & API → authorize your current public IP (or turn off IP restriction).
EMAIL_BACKEND=smtp
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=no-reply@yourdomain.com
SMTP_FROM_NAME=Poultech Solution
EMAIL_TAGLINE=Smart solutions for profitable poultry
MAILPIT_SMTP_HOST_PORT=1025
MAILPIT_UI_HOST_PORT=8025

# --- HTTP / Google / ops ---
API_HOST_PORT=8000
# Host `uvicorn` / tests
CORS_ORIGINS=http://localhost:5173,http://localhost:8088,http://127.0.0.1:8088,http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006
# Docker `api` container (overrides host CORS_ORIGINS in compose)
CORS_ORIGINS_DOCKER=http://localhost:5173,http://localhost:8088,http://127.0.0.1:8088,http://localhost:8080,http://127.0.0.1:8080,http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006
# Google Sign-In: OAuth **Web client** ID (same string as EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID).
# Backend verifies the ID token audience only — do NOT put client_secret in this app.
# JavaScript origins: set EXPO_PUBLIC_GOOGLE_JS_ORIGINS in frontend/.env and mirror each URI in Google Console.
GOOGLE_CLIENT_ID=
TRUST_FORWARDED_FOR=false
# Host `uvicorn` / prod-like runs
RATE_LIMIT_ENABLED=true
# Docker `app` profile — compose overrides with this (default false for local login testing)
RATE_LIMIT_ENABLED_DOCKER=false

# --- NECC egg rates (market module) ---
NECC_EGG_PRICE_URL=https://www.e2necc.com/home/eggprice
MARKET_DEFAULT_ZONE=Pune
MARKET_SYNC_ENABLED=true
MARKET_HTTP_TIMEOUT_SECONDS=30
MARKET_DASHBOARD_CACHE_SECONDS=300
MARKET_SYNC_MONTHS_BACK=12
MARKET_COMPARE_MAX_ZONES=50
# Celery Beat (Asia/Kolkata): 02:00 IST full months_back pull; hourly current month for today's cell.
# App /market/* never calls NECC; users read Postgres (+ short Redis cache).
MARKET_SYNC_CRON_MINUTE=0
MARKET_SYNC_CRON_HOUR=2
MARKET_SYNC_HOURLY=true

# India pincode directory (geo module) — import CSV once; see docs/GEO_PINCODES.md
GEO_PINCODE_STRICT=true
GEO_PINCODE_SEARCH_MIN_DIGITS=3
GEO_PINCODE_SEARCH_LIMIT=15
GEO_PINCODE_CACHE_SECONDS=86400
